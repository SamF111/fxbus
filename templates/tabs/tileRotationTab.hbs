<p class="fxbus-muted">
  Rotate selected tiles indefinitely. Useful for planets, gears, fans, portals, magic circles, clockwork, radar sweeps, and solar-system props.
</p>

<p class="fxbus-muted" data-tile-rotation-selection-summary>
  Select tiles with Foundry's native Tile tool, then apply rotation.
</p>

<div class="fxbus-grid-2">
  <div class="form-group">
    <label>Speed (deg/s)</label>
    <input
      type="number"
      name="tileRotationSpeedDegPerSec"
      value="15"
      step="1"
      min="0"
      max="1440"
    />
  </div>

  <div class="form-group">
    <label>Direction</label>
    <select name="tileRotationDirection">
      <option value="cw" selected>Clockwise</option>
      <option value="ccw">Counter-clockwise</option>
    </select>
  </div>
</div>

<div class="fxbus-grid-2">
  <div class="form-group">
    <label>Start offset (deg)</label>
    <input
      type="number"
      name="tileRotationStartOffsetDeg"
      value="0"
      step="1"
      min="-3600"
      max="3600"
    />
  </div>

  <div class="form-group">
    <label class="fxbus-inline">
      <input
        type="checkbox"
        name="tileRotationRandomStartOffset"
      />
      Random offset
    </label>
  </div>
</div>

<div class="form-group">
  <label class="fxbus-inline">
    <input
      type="checkbox"
      name="tileRotationRestoreOnStop"
      checked
    />
    Restore original angle on stop
  </label>
</div>

<hr class="fxbus-divider"/>

<div class="fxbus-row">
  <button type="button" class="fxbus-do" data-do="tileRotationApply">
    Apply
  </button>

  <button type="button" class="fxbus-do fxbus-smallbtn" data-do="tileRotationStopSelected">
    Stop Selected
  </button>

  <button type="button" class="fxbus-do fxbus-smallbtn" data-do="tileRotationStopAll">
    Stop All
  </button>

  <button type="button" data-action="fxbusCopyToMacro" class="fxbus-smallbtn">
    Copy to Macro
  </button>
</div>