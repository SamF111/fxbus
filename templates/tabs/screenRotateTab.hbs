{{!-- D:\FoundryVTT\Data\modules\fxbus\templates\tabs\screenRotateTab.hbs --}}

<p class="fxbus-muted">
  Visual-only canvas roll. Use for disorientation, ship movement, impacts, dream logic, unstable rooms, or cinematic scene shifts.
</p>

<hr class="fxbus-divider"/>

<div class="fxbus-grid-2">
  <div class="form-group">
    <label>Angle (deg)</label>
    <input
      type="number"
      name="rotateAngleDeg"
      value="45"
      step="1"
      min="-720"
      max="720"
    />
  </div>

  <div class="form-group">
    <label>Duration (ms)</label>
    <input
      type="number"
      name="rotateDurationMs"
      value="2500"
      step="50"
      min="1"
      max="60000"
    />
  </div>
</div>

<div class="fxbus-grid-2">
  <div class="form-group">
    <label>Mode</label>
    <select name="rotateMode">
      <option value="wobble" selected>Wobble</option>
      <option value="wobbleHold">Wobble Hold</option>
      <option value="ease">Ease</option>
      <option value="spin">Spin</option>
      <option value="snap">Snap</option>
    </select>
  </div>

  <div class="form-group">
    <label>Frequency (Hz)</label>
    <input
      type="number"
      name="rotateFreqHz"
      value="0.7"
      step="0.1"
      min="0.01"
      max="30"
    />
  </div>
</div>

<div class="form-group">
  <label class="fxbus-inline">
    <input
      type="checkbox"
      name="rotateReturnWhenFinished"
      checked
    />
    Return when finished
  </label>
</div>

<hr class="fxbus-divider"/>

<div class="fxbus-row">
  <button type="button" class="fxbus-do" data-action="rotateStart">Apply</button>
  <button type="button" class="fxbus-do fxbus-smallbtn" data-action="rotateStop">Stop</button>
  <button type="button" class="fxbus-do fxbus-smallbtn" data-action="fxbusCopyToMacro">Copy to Macro</button>
</div>