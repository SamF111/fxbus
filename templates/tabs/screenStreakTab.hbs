<p class="fxbus-muted">
  Directional screen-space motion trail using temporal feedback. Duration 0 runs until stopped.
</p>

<hr class="fxbus-divider" />

<div class="fxbus-grid-2">
  <div class="form-group">
    <label>Strength (0-1)</label>
    <input
      type="number"
      name="strength"
      value="0.6"
      step="0.01"
      min="0"
      max="1"
    />
  </div>

  <div class="form-group">
    <label>Persistence (0-1)</label>
    <input
      type="number"
      name="persistence"
      value="0.9"
      step="0.01"
      min="0"
      max="0.999"
    />
  </div>
</div>

<div class="fxbus-grid-2">
  <div class="form-group">
    <label>Length (px)</label>
    <input
      type="number"
      name="lengthPx"
      value="60"
      step="1"
      min="0"
      max="2000"
    />
  </div>

  <div class="form-group">
    <label>Angle (deg)</label>
    <input
      type="number"
      name="angleDeg"
      value="0"
      step="1"
      min="-360"
      max="360"
    />
  </div>
</div>

<div class="fxbus-grid-2">
  <div class="form-group">
    <label>Jitter (px)</label>
    <input
      type="number"
      name="jitterPx"
      value="0"
      step="1"
      min="0"
      max="200"
    />
  </div>

  <div class="form-group">
    <label>Pulse Frequency (Hz)</label>
    <input
      type="number"
      name="freqHz"
      value="0"
      step="0.1"
      min="0"
      max="60"
    />
  </div>
</div>

<div class="fxbus-grid-2">
  <div class="form-group">
    <label>Envelope</label>
    <select name="ease">
      <option value="inOut" selected>In-out</option>
      <option value="in">In</option>
      <option value="out">Out</option>
      <option value="linear">Linear</option>
    </select>
  </div>

  <div class="form-group">
    <label>Duration (ms)</label>
    <input
      type="number"
      name="durationMs"
      value="1200"
      step="50"
      min="0"
      max="600000"
    />
  </div>
</div>

<div class="fxbus-grid-2">
  <div class="form-group">
    <label>Ramp In (ms)</label>
    <input
      type="number"
      name="rampMs"
      value="250"
      step="10"
      min="0"
      max="1000"
    />
  </div>

  <div class="form-group">
    <label class="fxbus-inline" style="margin-top:22px;">
      <input type="checkbox" name="runUntilStopped" checked />
      Run until stopped
    </label>
  </div>
</div>

<hr class="fxbus-divider" />

<div class="fxbus-row">
  <button type="button" class="fxbus-do" data-action="apply">Apply</button>
  <button type="button" class="fxbus-do fxbus-smallbtn" data-action="stop">Stop</button>
  <button type="button" class="fxbus-do fxbus-smallbtn" data-action="fxbusCopyToMacro">Copy to Macro</button>
</div>