          data-group="fxbus"
          data-category="screen"
          data-tab="chromab"
        >
          {{> "modules/fxbus/templates/tabs/screenChromAbTab.hbs"}}
        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'screen') (eq activeTab 'noise'))}}active{{/if}}"
          data-group="fxbus"
          data-category="screen"
          data-tab="noise"
        >
          {{> "modules/fxbus/templates/tabs/screenNoiseTab.hbs"}}
        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'screen') (eq activeTab 'blur'))}}active{{/if}}"
          data-group="fxbus"
          data-category="screen"
          data-tab="blur"
        >
          {{> "modules/fxbus/templates/tabs/screenBlurTab.hbs"}}
        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'screen') (eq activeTab 'smear'))}}active{{/if}}"
          data-group="fxbus"
          data-category="screen"
          data-tab="smear"
        >
          {{> "modules/fxbus/templates/tabs/screenSmearTab.hbs"}}
        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'screen') (eq activeTab 'streak'))}}active{{/if}}"
          data-group="fxbus"
          data-category="screen"
          data-tab="streak"
        >
