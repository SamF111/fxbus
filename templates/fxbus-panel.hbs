        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'screen') (eq activeTab 'monochrome'))}}active{{/if}}"
          data-group="fxbus"
          data-category="screen"
          data-tab="monochrome"
        >
          {{> "modules/fxbus/templates/tabs/screenMonochromeTab.hbs"}}
        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'canvas') (eq activeTab 'rotate'))}}active{{/if}}"
          data-group="fxbus"
          data-category="canvas"
          data-tab="rotate"
        >
          {{> "modules/fxbus/templates/tabs/screenRotateTab.hbs"}}
        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'reset') (eq activeTab 'reset'))}}active{{/if}}"
          data-group="fxbus"
          data-category="reset"
          data-tab="reset"
        >
          {{> "modules/fxbus/templates/tabs/resetTab.hbs"}}
        </section>
      </div>
    </div>
  </div>
</form>