<form class="fxbus-panel" data-fxbus-root="1">
  <div class="fxbus-panel-layout">
    <nav class="fxbus-category-rail" aria-label="FX Bus categories">
      {{#each groups}}
        <a
          class="fxbus-category-tab {{#if this.active}}active{{/if}}"
          data-category="{{this.id}}"
          aria-selected="{{#if this.active}}true{{else}}false{{/if}}"
        >
          {{this.label}}
        </a>
      {{/each}}
    </nav>

    <div class="fxbus-main">
      <nav class="tabs fxbus-subtabs" data-group="fxbus" aria-label="FX Bus effects">
        {{#each activeTabs}}
          <a
            class="item fxbus-subtab {{#if this.active}}active{{/if}}"
            data-group="fxbus"
            data-category="{{../activeCategory}}"
            data-tab="{{this.id}}"
            aria-selected="{{#if this.active}}true{{else}}false{{/if}}"
          >
            {{this.label}}
          </a>
        {{/each}}
      </nav>

      <div class="fxbus-effect-body">
        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'token') (eq activeTab 'osc'))}}active{{/if}}"
          data-group="fxbus"
          data-category="token"
          data-tab="osc"
        >
          {{> "modules/fxbus/templates/tabs/tokenOscTab.hbs"}}
        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'token') (eq activeTab 'laser'))}}active{{/if}}"
          data-group="fxbus"
          data-category="token"
          data-tab="laser"
        >
          {{> "modules/fxbus/templates/tabs/tokenLaserTab.hbs"}}
        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'token') (eq activeTab 'recoil'))}}active{{/if}}"
          data-group="fxbus"
          data-category="token"
          data-tab="recoil"
        >
          {{> "modules/fxbus/templates/tabs/tokenRecoilTab.hbs"}}
        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'token') (eq activeTab 'tokenDollyZoom'))}}active{{/if}}"
          data-group="fxbus"
          data-category="token"
          data-tab="tokenDollyZoom"
        >
          {{> "modules/fxbus/templates/tabs/tokenDollyZoomTab.hbs"}}
        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'tile') (eq activeTab 'tileOsc'))}}active{{/if}}"
          data-group="fxbus"
          data-category="tile"
          data-tab="tileOsc"
        >
          {{> "modules/fxbus/templates/tabs/tileOscTab.hbs"}}
        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'tile') (eq activeTab 'tileFlicker'))}}active{{/if}}"
          data-group="fxbus"
          data-category="tile"
          data-tab="tileFlicker"
        >
          {{> "modules/fxbus/templates/tabs/tileFlickerTab.hbs"}}
        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'tile') (eq activeTab 'tileFlow'))}}active{{/if}}"
          data-group="fxbus"
          data-category="tile"
          data-tab="tileFlow"
        >
          {{> "modules/fxbus/templates/tabs/tileFlowTab.hbs"}}
        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'screen') (eq activeTab 'shake'))}}active{{/if}}"
          data-group="fxbus"
          data-category="screen"
          data-tab="shake"
        >
          {{> "modules/fxbus/templates/tabs/screenShakeTab.hbs"}}
        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'screen') (eq activeTab 'pulse'))}}active{{/if}}"
          data-group="fxbus"
          data-category="screen"
          data-tab="pulse"
        >
          {{> "modules/fxbus/templates/tabs/screenPulseTab.hbs"}}
        </section>

        <section
          class="tab fxbus-panel-section {{#if (and (eq activeCategory 'screen') (eq activeTab 'vignette'))}}active{{/if}}"
          data-group="fxbus"
          data-category="screen"
          data-tab="vignette"
        >
          {{> "modules/fxbus/templates/tabs/screenVignetteTab.hbs"}}
        </section>

        <section
